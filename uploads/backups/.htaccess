# =============================================================================
# CBIM - PROTEKSI DIREKTORI BACKUP
# =============================================================================
# Direktori ini berisi dump database lengkap (termasuk data pribadi calon
# peserta didik). Tanpa file ini, Apache akan melayani file .sql.gz secara
# langsung karena aturan rewrite di root hanya aktif bila file TIDAK ada
# (RewriteCond %{REQUEST_FILENAME} !-f).
#
# CATATAN: file ini adalah jaring pengaman lapis kedua. Solusi utamanya adalah
# memindahkan direktori backup ke luar web root - lihat Backup.php.
# =============================================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback untuk shared hosting lama)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Matikan directory listing
Options -Indexes
